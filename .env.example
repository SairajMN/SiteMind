# SiteMind API — copy to .env and fill in values

# Application
APP_NAME=SiteMind API
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=change-me-in-production
ALLOW_LOCALHOST_TARGETS=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limits (requests per minute)
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_SITES_POST=5
RATE_LIMIT_ASK=10

# Crawl safety caps
CRAWL_MAX_DEPTH=5
CRAWL_MAX_PAGE_BUDGET=200
CRAWL_DEFAULT_PAGE_BUDGET=60
CRAWL_DEFAULT_DEPTH=3

# Data stores
DATABASE_URL=postgresql+asyncpg://sitemind:sitemind@localhost:5432/sitemind
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sitemind_chunks

# LLM providers (optional for worker / Q&A)
GROQ_API_KEY=
OPENROUTER_API_KEY=
INCEPTION_API_KEY=
DEFAULT_LLM_PROVIDER=groq
